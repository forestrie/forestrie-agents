{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/forestrie/forestrie-agents/main/schemas/status.schema.json",
  "title": "Forestrie status snapshot frontmatter",
  "description": "A resumable checkpoint of one workstream, kept in forestrie/work status/. Uses the plan status vocabulary so work documents share one set of values.",
  "type": "object",
  "properties": {
    "id": {
      "description": "The filename stem: status-YYMM-NN-<slug>, or a frozen legacy status-NNNN-<slug>.",
      "type": "string",
      "pattern": "^status-[0-9]{4}(?:-[0-9]{2})?-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["draft", "active", "blocked", "complete", "abandoned"]
    },
    "repos": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/home" },
      "uniqueItems": true
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/issueRef" },
      "uniqueItems": true
    },
    "plans": {
      "description": "The plans this workstream is executing.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/workRef" },
      "uniqueItems": true
    }
  },
  "required": ["id", "title", "status", "created", "updated"],
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "unevaluatedProperties": false
}
